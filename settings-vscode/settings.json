/* PARA TEMA GITHUB DARK MODE */
"editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": [
          "keyword",
          "keyword.operator",
          "keyword.control"
        ],
        "settings": {
          "foreground": "#1d8fec",
          "fontStyle": "italic"
        }
      },
      {
            "scope": "storage.type", // Para 'function', 'var', 'let', 'const'
            "settings": {
                "foreground": "#1d8fec" 
            }
        },
        {
            "scope": "keyword.control", // Para 'if', 'else', 'return', 'for'
            "settings": {
                "foreground": "#FF00FF"
            }
        },
      {
        "scope": [
          "punctuation.definition.tag"
        ],
        "settings": {
          "foreground": "#1d8fec"
        }
      },
      {
        "scope": [
          "keyword.control.import",
          "keyword.control.export"
        ],
        "settings": {
          "foreground": "#0da3e9"
        }
      },
      {
        "scope": [
          "variable",
          "variable.other"
        ],
        "settings": {
          "fontStyle": "bold"
        }
      },
      {
        "scope": [
          "entity.name.function"
        ],
        "settings": {
          "foreground": "#DCDCAA",
          "fontStyle": "italic"
        }
      },
      {
        "scope": [
          "entity.name.tag"
        ],
        "settings": {
          "foreground": "#d6159c"
        }
      },
      {
        "scope": [
          "string",
          "string.quoted",
          "string.template"
        ],
        "settings": {
          "foreground": "#e8ba3c"
        }
      },
      {
        "scope": [
          "constant.numeric"
        ],
        "settings": {
          "foreground": "#e62796"
        }
      },
      {
        "scope": [
          "meta.import variable.other.readwrite"
        ],
        "settings": {
          "foreground": "#a80d68"
        }
      }
    ],
    "comments": "#ad77a4"
  },
